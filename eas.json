{
  "cli": {
    "version": ">= 27.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.23.3",
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.1"
      },
      "android": {
        "image": "ubuntu-26.04-jdk-17-ndk-r27b-sdk-58"
      }
    },
    "development": {
      "extends": "base",
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "extends": "base",
      "environment": "preview",
      "developmentClient": false,
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "extends": "base",
      "environment": "production",
      "developmentClient": false,
      "autoIncrement": true,
      "channel": "production"
    },
    "ios-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      },
      "channel": "ios-simulator"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6749234696"
      }
    }
  }
}
