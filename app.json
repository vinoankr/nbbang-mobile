{
  "expo": {
    "name": "엔빵",
    "slug": "nbbang-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nbbang",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.busitdol.nbbang",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.busitdol.nbbang",
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [
              "https://devrepo.kakao.com/nexus/content/groups/public/"
            ]
          }
        }
      ],
      [
        "@react-native-kakao/core",
        {
          "nativeAppKey": "93959bb8c9aa19c9ae9ad2ca73ffb3c5",
          "android": {
            "authCodeHandlerActivity": true
          },
          "ios": {
            "handleKakaoOpenUrl": true
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "intentFilters": [
              {
                "action": "VIEW",
                "data": [
                  {
                    "scheme": "https",
                    "host": "nbbang.app",
                    "pathPrefix": "/"
                  }
                ],
                "category": ["BROWSABLE", "DEFAULT"]
              }
            ]
          },
          "ios": {
            "associatedDomains": ["applinks:nbbang.app"]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "59dd5b05-0d7a-4339-8681-ef0f89017de4"
      }
    },
    "owner": "vinoankr"
  }
}
