{
  "name": "nbbang-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "npx expo start --clear",
    "start-android": "npx expo start --dev-client",
    "android": "eas build --platform android --profile development",
    "android-preview": "eas build --platform android --profile preview",
    "android-production": "eas build --platform android --profile production",
    "android-submit": "eas submit --platform android",
    "ios": "eas build --platform ios --profile development",
    "ios-simulator": "eas build --platform ios --profile ios-simulator",
    "ios-preview": "eas build --platform ios --profile preview",
    "ios-production": "eas build --platform ios --profile production",
    "ios-submit": "eas submit --platform ios",
    "update-preview": "eas update --channel preview --environment preview --message update",
    "update-production": "eas update --channel production --environment production --message update",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/web",
    "lint": "expo lint",
    "build:web": "expo export --platform web",
    "preview:web": "node scripts/serve-web.mjs",
    "test:web": "playwright test",
    "verify:web": "EXPO_PUBLIC_API_URL=http://127.0.0.1:4319 expo export --platform web && playwright test",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-kakao/core": "2.4.11",
    "@react-native-kakao/user": "2.4.11",
    "@react-native-menu/menu": "2.0.0",
    "@react-native-picker/picker": "2.11.4",
    "@sentry/react-native": "~8.28.0",
    "@tanstack/query-async-storage-persister": "^5.83.1",
    "@tanstack/react-query": "^5.80.7",
    "@tanstack/react-query-persist-client": "^5.84.1",
    "axios": "^1.9.0",
    "es-hangul": "^2.3.5",
    "expo": "~58.0.21",
    "expo-apple-authentication": "~58.0.2",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.11",
    "expo-checkbox": "~58.0.2",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.17",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.15",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.19",
    "lucide-react-native": "^0.525.0",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.60.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-mmkv": "^4.3.2",
    "react-native-modal-datetime-picker": "^18.0.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.7.1",
    "react-native-reserved-regions": "0.2.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-toast-message": "^2.3.3",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "^3.4.17",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "patch-package": "^8.0.1",
    "react-native-svg-transformer": "^1.5.1",
    "typescript": "~6.0.3"
  },
  "private": true
}
